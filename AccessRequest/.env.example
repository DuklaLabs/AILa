# Copy to AccessRequest/.env (gitignored) and fill in real values before
# the excuse-request weekly digest goes live. Until SMTP_HOST is set,
# app/mailer.py will raise KeyError as soon as it tries to send anything —
# that's deliberate (fail loud, not send-to-nowhere silently).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
SMTP_FROM_NAME=DuklaLabs

# Base URL used to build links in emails (teacher approve/deny, student
# notifications). Local/LAN for now; switch to https://labs.spssecb.cz once
# that domain is live.
PUBLIC_BASE_URL=http://localhost:8003
