# Backend: "smtp" pro testy přes Gmail, "graph" pro ostrý provoz (spssecb.cz).
MAIL_BACKEND=smtp

# ==== SMTP (Gmail) – dočasně pro testování ====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=honzapetrasek@gmail.com
SMTP_PASSWORD=            # Gmail app password
SMTP_FROM=               # nepovinné, default = SMTP_USER
SMTP_FROM_NAME=AILa

# ==== MICROSOFT GRAPH (app-only) ====
# Hodnoty dodá IT školy po registraci aplikace v Entra ID (viz Readme.md).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MAIL_SENDER=petrasek@spssecb.cz

# ==== Provozní přepínače ====
MAIL_ENABLED=true
MAIL_DRY_RUN=false
# Bezpečnostní brzda: když je vyplněno, VŠECHNA pošta jde jen na tuto adresu
# (původní příjemci se propíšou do předmětu a těla). Prázdné = posílá se normálně.
MAIL_REDIRECT_TO=

# ==== GENERAL ====
AGENT_PORT=8005
