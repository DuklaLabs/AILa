# Zkopíruj do Projects/.env (soubor v .gitignore, api klíče se necommitují).
# docker-compose.yml ho tahá přes env_file: ./Projects/.env.

# ailacore.obsidian (paměť agentů). Obsidian musí běžet na stroji, kde je
# tenhle .env použitý (v Dockeru viz OBSIDIAN_BASE_URL=host.docker.internal
# už nastavené v docker-compose.yml) — otevřený vault + nainstalovaný a
# zapnutý plugin "Local REST API". API key je v nastavení pluginu v Obsidianu.
OBSIDIAN_API_KEY=

# Pocket panel (viz Projects/README.md — zatím se sem musí dosadit ručně,
# docker-compose.yml pro ně zatím nemá vlastní environment: řádky).
# POCKET_API_KEY=
# POCKET_UPLOAD_API_KEY=
