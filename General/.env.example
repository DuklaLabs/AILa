# Zkopíruj do General/.env (soubor v .gitignore, api klíče se necommitují).
# docker-compose.yml ho tahá přes env_file: ./General/.env.

# ailacore.llm (sensitive=False -> 9Router). Klíč se generuje v 9Router
# dashboardu (http://localhost:20128 -> Providers/Endpoint). Shared/README.md
# doporučuje samostatný klíč na službu, ale v praxi tu jede stejný jako
# Projects/.env a AccessAgents/.env – zkopíruj hodnoty odtud. Bez klíče
# complete(..., sensitive=False) spadne rovnou s RuntimeError, ne až chybou
# z 9Router.
ROUTER_API_KEY=
ROUTER_MODEL=
